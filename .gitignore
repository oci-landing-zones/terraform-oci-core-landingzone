# Ignore every top-level directory except the project artifacts kept in version control.
/*/
!/.ci/
!/extensions/
!/images/
!/templates/

*.zip
**/.terraform.lock.hcl
/.ci/scripts/

# Ignore Terraform runtime artifacts generated while working with templates.
/templates/**/.terraform/
/templates/**/.terraform.lock.hcl.backup
/templates/**/*.tfstate
/templates/**/*.tfstate.*
/templates/**/crash.log
/templates/**/crash.*.log
/templates/**/*.tfvars
/templates/**/*.tfvars.json
/templates/**/override.tf
/templates/**/override.tf.json
/templates/**/*_override.tf
/templates/**/*_override.tf.json
/templates/**/.terraformrc
/templates/**/terraform.rc
/templates/**/main.tf
/templates/**/tfplan
/templates/**/*.tfplan
/templates/**/plan.*
/templates/**/*.out

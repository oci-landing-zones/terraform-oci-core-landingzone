# ----------------------------------------------------------------------------------------
# -- This configuration deploys a Core Landing Zone hub & spoke topology that terminates
# -- both FastConnect and IPSec VPN connectivity while enforcing OCI Native Network Firewall.
# -- Use it when you need dual-homed on-premises connectivity with north/south inspection.
# -- 1. Rename this file to main.tf.
# -- 2. Provide/review the variable assignments below.
# -- 3. Run terraform init/plan/apply from this folder (twice for the firewall association).
# ----------------------------------------------------------------------------------------

module "core_lz" {
  source = "../../"

  # ------------------------------------------------------
  # ----- Environment
  # ------------------------------------------------------
  tenancy_ocid         = "ocid1.tenancy.oc1..aaaaaaaa...example"
  user_ocid            = "ocid1.user.oc1..aaaaaaaa...example"
  fingerprint          = "aa:bb:cc:dd:ee:ff:11:22:33:44:55:66"
  private_key_path     = "path-to-private-key.pem"
  private_key_password = ""
  region               = "us-ashburn-1"
  service_label        = "hybrid"

  # ------------------------------------------------------
  # ----- Networking
  # ------------------------------------------------------
  define_net                          = true
  hub_deployment_option               = "VCN or on-premises connectivity routing through DMZ VCN with Network Virtual Appliance (DRG and DMZ VCN will be created)"
  hub_vcn_cidrs                       = ["10.60.0.0/26"]
  hub_vcn_deploy_net_appliance_option = "OCI Native Firewall"
  enable_native_firewall_threat_log   = true
  enable_native_firewall_traffic_log  = true
  onprem_cidrs                        = ["192.168.10.0/23", "172.20.0.0/22"]
  allowed_onprem_cidrs_to_fw_mgmt_interface = ["198.51.100.10/32"]
  fw_mgmt_interface_ports                   = ["TCP:22", "TCP:443"]
  deploy_bastion_service                    = true
  deploy_bastion_jump_host                  = true
  bastion_service_allowed_cidrs             = ["198.51.100.0/24"]

  # --- Hybrid connectivity (FastConnect + IPSec)
  on_premises_connection_option                       = "Create New FastConnect Virtual Circuit and IPSec VPN"
  fastconnect_virtual_circuit_name                    = "Hybrid-FC"
  fastconnect_virtual_circuit_type                    = "PRIVATE"
  fastconnect_virtual_circuit_bandwidth_shape         = "2 Gbps"
  fastconnect_virtual_circuit_customer_asn            = "65010"
  fastconnect_virtual_circuit_customer_bgp_peering_ip = "10.250.0.2/30"
  fastconnect_virtual_circuit_oracle_bgp_peering_ip   = "10.250.0.1/30"
  fastconnect_virtual_circuit_vlan                    = "200"
  fastconnect_virtual_circuit_provider_service_id     = "ocid1.providerservice.oc1..example"
  cpe_ip_address                                      = "203.0.113.10"
  cpe_device_shape_vendor                             = "Cisco CSR1000V"
  ipsec_vpn_name                                      = "Hybrid-VPN"
  ipsec_customer_bgp_asn                              = "65010"
  ipsec_tunnel1_customer_interface_ip                 = "10.251.0.2/30"
  ipsec_tunnel1_oracle_interface_ip                   = "10.251.0.1/30"
  ipsec_tunnel1_ike_version                           = "V2"
  ipsec_tunnel2_customer_interface_ip                 = "10.251.0.6/30"
  ipsec_tunnel2_oracle_interface_ip                   = "10.251.0.5/30"
  ipsec_tunnel2_ike_version                           = "V2"

  # --- Spoke: Three-tier VCN
  add_tt_vcn1                 = true
  tt_vcn1_cidrs               = ["10.0.0.0/20"]
  tt_vcn1_attach_to_drg       = true
  tt_vcn1_onprem_route_enable = true

  # --- Spoke: OKE VCN
  add_oke_vcn1                 = true
  oke_vcn1_cni_type            = "Native"
  oke_vcn1_cidrs               = ["10.3.0.0/16"]
  oke_vcn1_attach_to_drg       = true
  oke_vcn1_onprem_route_enable = true

  # --- Spoke: Exadata VCN
  add_exa_vcn1                 = true
  exa_vcn1_cidrs               = ["10.30.0.0/22"]
  exa_vcn1_attach_to_drg       = true
  exa_vcn1_onprem_route_enable = true

  # --- Firewall association (second apply)
  # oci_firewall_ip_ocid  = "ocid1.privateip.oc1..example"  # fill after first apply
  # oci_nfw_policy_ocid   = "ocid1.networkfirewallpolicy.oc1..example"  # reference your curated policy

  # ------------------------------------------------------
  # ----- Notifications
  # ------------------------------------------------------
  network_admin_email_endpoints  = ["network.team@example.com"]
  security_admin_email_endpoints = ["security.team@example.com"]

  # ------------------------------------------------------
  # ----- Governance
  # ------------------------------------------------------
  create_budget                = true
  budget_amount                = 7000
  budget_alert_threshold       = 85
  budget_alert_email_endpoints = ["finops@example.com"]
}

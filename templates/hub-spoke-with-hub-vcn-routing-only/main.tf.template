# ----------------------------------------------------------------------------------------
# -- This configuration deploys a CIS compliant landing zone that uses a Hub VCN strictly
# -- for centralized routing. No firewall is created in the DMZ VCN, which lets you start
# -- with simple routing-only hub/spoke topologies and layer additional network security
# -- services later. It enables two three-tier VCNs, one OKE VCN, and one Exadata VCN.
# -- 1. Rename this file to main.tf.
# -- 2. Provide/review the variable assignments below.
# -- 3. In this folder, execute the typical Terraform workflow:
# ----- $ terraform init
# ----- $ terraform plan
# ----- $ terraform apply
# ----------------------------------------------------------------------------------------

module "core_lz" {
  source = "../../"

  # ------------------------------------------------------
  # ----- Environment
  # ------------------------------------------------------
  tenancy_ocid         = "ocid1.tenancy.oc1..aaaaaaaa...example"  # Replace with your tenancy OCID.
  user_ocid            = "ocid1.user.oc1..aaaaaaaa...example"     # Replace with your user OCID.
  fingerprint          = "xx:yy:zz:11:22:33:44:55:66:77:88:99"    # Replace with your API signing key fingerprint.
  private_key_path     = "path-to-private-key.pem"                # Replace with your private key path.
  private_key_password = ""                                       # Replace only if the private key is encrypted.
  region               = "us-phoenix-1"                           # Replace with target OCI region name.
  service_label        = "routinghub"                             # Prefix prepended to deployed resource names.

  # ------------------------------------------------------
  # ----- Networking
  # ------------------------------------------------------
  define_net                          = true
  hub_deployment_option               = "VCN or on-premises connectivity routing through DMZ VCN with Network Virtual Appliance (DRG and DMZ VCN will be created)"
  hub_vcn_cidrs                       = ["10.50.0.0/26"]
  hub_vcn_deploy_net_appliance_option = "Don't deploy any network appliance at this time"
  enable_cross_vcn_open_nsg           = true
  onprem_cidrs                        = ["172.16.10.0/24"]
  deploy_bastion_service              = true
  bastion_service_allowed_cidrs       = ["203.0.113.0/32"]

  # --- Spoke: Three-tier VCN 1 (shared services)
  add_tt_vcn1                 = true
  tt_vcn1_name                = "TT-VCN-1"
  tt_vcn1_cidrs               = ["10.0.0.0/20"]
  tt_vcn1_attach_to_drg       = true
  tt_vcn1_onprem_route_enable = true

  # --- Spoke: Three-tier VCN 2 (private-only workloads)
  add_tt_vcn2                   = true
  tt_vcn2_name                  = "TT-VCN-2"
  tt_vcn2_cidrs                 = ["10.1.0.0/20"]
  tt_vcn2_web_subnet_is_private = true
  tt_vcn2_attach_to_drg         = true

  # --- Spoke: OKE VCN (container platforms)
  add_oke_vcn1                 = true
  oke_vcn1_name                = "OKE-VCN-1"
  oke_vcn1_cni_type            = "Native"
  oke_vcn1_cidrs               = ["10.10.0.0/16"]
  oke_vcn1_attach_to_drg       = true

  # --- Spoke: Exadata VCN (database landing zone)
  add_exa_vcn1                 = true
  exa_vcn1_name                = "EXA-VCN-1"
  exa_vcn1_cidrs               = ["10.20.0.0/22"]
  exa_vcn1_attach_to_drg       = true

  # ------------------------------------------------------
  # ----- Notifications
  # ------------------------------------------------------
  network_admin_email_endpoints  = ["network.team@example.com"]
  security_admin_email_endpoints = ["security.team@example.com"]

  # ------------------------------------------------------
  # ----- Governance
  # ------------------------------------------------------
  create_budget                = true
  budget_amount                = 5000
  budget_alert_threshold       = 90
  budget_alert_email_endpoints = ["finops@example.com"]
}
